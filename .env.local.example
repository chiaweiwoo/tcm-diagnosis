# Shared secret for assess:run CLI to call /api/organize and /api/analyze on the live Vercel app.
# Generate with: openssl rand -hex 32
# Must match the value set in Vercel environment variables.
# Also add to GitHub Actions secrets for assess:review workflow.
ASSESSMENT_API_KEY=your_assessment_api_key_here

# Langfuse observability — tokens + call metadata only, no clinical text.
# Add to Vercel env vars for production. Local dev optional.
# Keys from: https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASEURL=https://cloud.langfuse.com   # omit to use default

# Required for assess:frontend visual reviewer (Claude vision)
# Local-only — do NOT add to Vercel
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
