# Optional: point to a JSON of { flash: {...}, pro: {...} } with current DeepSeek prices.
# Fetched at most once per day (server) or once per CLI run. Falls back to per-tier env
# vars below, then hardcoded defaults. Update this URL when DeepSeek changes pricing.
DEEPSEEK_RATES_URL=

# Per-tier env overrides (applied on top of DEEPSEEK_RATES_URL or hardcoded defaults).
# Leave blank to use DEEPSEEK_RATES_URL or hardcoded fallback.
DEEPSEEK_FLASH_INPUT_CACHE_HIT_PER_1M=
DEEPSEEK_FLASH_INPUT_CACHE_MISS_PER_1M=
DEEPSEEK_FLASH_OUTPUT_PER_1M=
DEEPSEEK_PRO_INPUT_CACHE_HIT_PER_1M=
DEEPSEEK_PRO_INPUT_CACHE_MISS_PER_1M=
DEEPSEEK_PRO_OUTPUT_PER_1M=
DEV_AUTH_BYPASS=false
DEV_AUTH_EMAIL=chiaweiwoo123@gmail.com

# Required for assess:frontend visual reviewer (Claude vision)
# Local-only — do NOT add to Vercel
ANTHROPIC_API_KEY=your_anthropic_api_key_here
