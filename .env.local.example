# Optional: URL of a JSON with current AI pricing for all providers.
# Fetched at most once per day (server) or once per CLI run. Falls back to per-provider
# env vars below, then hardcoded defaults. Update this URL when any provider changes pricing.
# JSON shape: { deepseek: { flash: {...}, pro: {...} }, anthropic: { haiku: {...}, sonnet: {...}, opus: {...} } }
# Each tier: { inputCacheHitPer1M, inputCacheMissPer1M, outputPer1M } (USD per 1M tokens)
AI_RATES_URL=

# DeepSeek per-tier overrides (applied on top of AI_RATES_URL or hardcoded defaults)
DEEPSEEK_FLASH_INPUT_CACHE_HIT_PER_1M=
DEEPSEEK_FLASH_INPUT_CACHE_MISS_PER_1M=
DEEPSEEK_FLASH_OUTPUT_PER_1M=
DEEPSEEK_PRO_INPUT_CACHE_HIT_PER_1M=
DEEPSEEK_PRO_INPUT_CACHE_MISS_PER_1M=
DEEPSEEK_PRO_OUTPUT_PER_1M=

# Anthropic per-tier overrides (CLI scripts only — Claude visual reviewer)
ANTHROPIC_SONNET_INPUT_CACHE_HIT_PER_1M=
ANTHROPIC_SONNET_INPUT_PER_1M=
ANTHROPIC_SONNET_OUTPUT_PER_1M=
